# Copia este archivo a .env y ajusta los valores.
# El backend carga .env automáticamente al arrancar (spring-dotenv).

# --- Base de datos (MySQL / MariaDB de Laragon o XAMPP) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyberguard
DB_USERNAME=root
DB_PASSWORD=

# --- Seguridad JWT (mínimo 32 caracteres fuera de laboratorio) ---
CYBERGUARD_JWT_SECRET=cyberguard-secreto-solo-para-desarrollo-local-2026

# --- CORS: orígenes del frontend autorizados (separados por coma) ---
CYBERGUARD_CORS_ORIGENES=http://localhost:5173

# --- Servidor ---
SERVER_PORT=8080
